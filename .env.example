# Local development only. Copy to .env or run scripts/bootstrap.ps1 to generate random values.
# Never reuse these placeholders or generated local values in staging/production.
KAGU_ERP_POSTGRES_DB=kagu_erp
KAGU_ERP_POSTGRES_HOST=127.0.0.1
KAGU_ERP_POSTGRES_PORT=55432
KAGU_ERP_POSTGRES_USER=kagu_erp_local_owner
KAGU_ERP_POSTGRES_PASSWORD=CHANGEME_LOCAL_ONLY_ERP_DB
KAGU_ERP_MIGRATOR_USER=kagu_erp_migrator
KAGU_ERP_MIGRATOR_PASSWORD=CHANGEME_LOCAL_ONLY_ERP_MIGRATOR
KAGU_ERP_APP_USER=kagu_erp_app
KAGU_ERP_APP_PASSWORD=CHANGEME_LOCAL_ONLY_ERP_APP

# Party report refresh Worker. Leave all three identity values blank to keep the
# consumer disabled. If one is set, tenant, actor and company allow-list are all required.
KAGU_ERP_REPORT_WORKER_TENANT_ID=
KAGU_ERP_REPORT_WORKER_ACTOR_ID=
KAGU_ERP_REPORT_WORKER_COMPANY_IDS=
KAGU_ERP_REPORT_WORKER_POLL_INTERVAL_SECONDS=5
KAGU_ERP_REPORT_WORKER_LEASE_SECONDS=120

KEYCLOAK_POSTGRES_DB=keycloak
KEYCLOAK_POSTGRES_USER=keycloak_local_owner
KEYCLOAK_POSTGRES_PASSWORD=CHANGEME_LOCAL_ONLY_KEYCLOAK_DB

KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=kagu-local-admin
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=CHANGEME_LOCAL_ONLY_KEYCLOAK_ADMIN
KAGU_KEYCLOAK_SMOKE_PASSWORD=CHANGEME_LOCAL_ONLY_KEYCLOAK_SMOKE

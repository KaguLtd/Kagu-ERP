        ],
        "type": "object",
        "properties": {
          "companyId": {
            "type": "string",
            "format": "uuid"
          },
          "statementId": {
            "type": "string",
            "format": "uuid"
          },
          "agingReportId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "SalesOrderCreateApiRequest": {
        "required": [
          "companyId",
          "lines"
        ],
        "type": "object",
        "properties": {
          "companyId": {
            "type": "string",
            "format": "uuid"
          },
          "lines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SalesOrderLineCreateApiRequest"
            }
          }
        }
      },
      "SalesOrderLifecycleApiResponse": {
        "required": [
          "id",
          "companyId",
          "makerId",
          "status",
          "version",
          "lines",
          "transitions"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "companyId": {
            "type": "string",
            "format": "uuid"
          },
          "makerId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "format": "int64"
          },
          "lines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SalesOrderLineApiResponse"
            }
          },
          "transitions": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/SalesOrderTransitionApiResponse"
            }
          }
        }
      },
      "SalesOrderLineApiResponse": {
        "required": [
          "id",
          "itemId",
          "baseUomCode",
          "orderedBaseQuantity"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "itemId": {
            "type": "string",
            "format": "uuid"
          },
          "baseUomCode": {
            "type": "string"
          },
          "orderedBaseQuantity": {
            "type": "string"
          }
        }
      },
      "SalesOrderLineCreateApiRequest": {
        "required": [
          "orderLineId",
          "itemId",
          "baseUomCode",
          "orderedBaseQuantity"
        ],
        "type": "object",
        "properties": {
          "orderLineId": {
            "type": "string",
            "format": "uuid"
          },
          "itemId": {
            "type": "string",
            "format": "uuid"
          },
          "baseUomCode": {
            "type": "string"
          },
          "orderedBaseQuantity": {
            "type": "string"
          }
        }
      },
      "SalesOrderTransitionApiRequest": {
        "required": [
          "companyId",
          "reason"
        ],
        "type": "object",
        "properties": {
          "companyId": {
            "type": "string",
            "format": "uuid"
          },
          "reason": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "SalesOrderTransitionApiResponse": {
        "required": [
          "eventId",
          "transition",
          "previousVersion",
          "newVersion",
          "occurredAt",
          "reason"
        ],
        "type": "object",
        "properties": {
          "eventId": {
            "type": "string",
            "format": "uuid"
          },
          "transition": {
            "type": "string"
          },
          "previousVersion": {
            "type": "integer",
            "format": "int64"
          },
          "newVersion": {
            "type": "integer",
            "format": "int64"
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "reason": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
